; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited.

[application]

config/name="MindArena"
config/description="A 3D gamified self-development universe"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/textures/ui/icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
ApiClient="*res://scripts/autoload/api_client.gd"
AuthManager="*res://scripts/autoload/auth_manager.gd"
PlayerData="*res://scripts/autoload/player_data.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

