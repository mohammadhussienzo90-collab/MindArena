# Auto detect text files
* text=auto

# Force LF for scripts
*.gd text eol=lf
*.py text eol=lf
*.json text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf binary
